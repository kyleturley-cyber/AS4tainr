# Keep Unix line endings for files that run inside Linux containers,
# even when the repo is checked out on Windows.
*.sh       text eol=lf
gradlew    text eol=lf
*.rpgle    text eol=lf
*.pf       text eol=lf
*.bat      text eol=crlf
*.lf       text eol=lf
*.dspf     text eol=lf
*.clle     text eol=lf

*.rpg      text eol=lf
*.prtf     text eol=lf
*.cmd      text eol=lf
