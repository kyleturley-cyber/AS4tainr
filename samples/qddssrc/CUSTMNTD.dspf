     A* CUSTMNTD: change a customer (sample). SELECT asks for a
     A* customer; CHANGE shows it with name and city to change.
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'Exit')
     A          R SELECT
     A                                  1  2SYSNAME
     A                                  1 32'Change Customer'
     A                                      DSPATR(HI)
     A                                  1 72DATE
     A                                  3  2'Type a customer number, press Enter.'
     A                                  5  4'Customer number . . . .'
     A            CUSNUM         5Y 0B  5 29EDTCDE(Z)
     A  30                                  ERRMSG('Customer not found.' 30)
     A  31                                  ERRMSG('Customer is being changed in another job. Try +
     A                                      again later.' 31)
     A  32                             21  2'Customer changed.'
     A                                 23  2'F3=Exit'
     A                                      COLOR(BLU)
     A          R CHANGE
     A                                      CA12(12 'Cancel')
     A                                  1  2SYSNAME
     A                                  1 32'Change Customer'
     A                                      DSPATR(HI)
     A                                  1 72DATE
     A                                  3  2'Type changes, press Enter.'
     A                                  5  4'Customer number . . . .'
     A            CUSNUM         5Y 0O  5 29EDTCDE(Z)
     A                                  6  4'Name  . . . . . . . . .'
     A            CUSNAM        30A  B  6 29CHECK(LC)
     A                                  7  4'City  . . . . . . . . .'
     A            CUSCTY        20A  B  7 29CHECK(LC)
     A                                  8  4'Balance due . . . . . .'
     A            CUSBAL         9Y 2O  8 29EDTCDE(J)
     A                                 23  2'F3=Exit   F12=Cancel'
     A                                      COLOR(BLU)
