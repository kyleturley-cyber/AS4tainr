     A* CUSTWRKD: work with customers (sample load-all subfile)
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'Exit')
     A          R CUSTSFL                   SFL
     A  50                                  SFLNXTCHG
     A            OPT            1A  B  7  3
     A  50                                  DSPATR(RI PC)
     A            CUSNO          5Y 0O  7  7EDTCDE(Z)
     A            CUSNAM        30A  O  7 14
     A            CUSCTY        20A  O  7 46
     A          R CUSTCTL                   SFLCTL(CUSTSFL)
     A                                      SFLSIZ(0050)
     A                                      SFLPAG(0004)
     A                                      CA12(12 'Cancel')
     A                                      OVERLAY
     A  31                                  SFLDSP
     A                                      SFLDSPCTL
     A  32                                  SFLCLR
     A  33                                  SFLEND(*MORE)
     A  40                                  SFLMSG('Type option 5 or leave +
     A                                      the option blank.' 40)
     A                                  1  2SYSNAME
     A                                  1 28'Work with Customers'
     A                                      DSPATR(HI)
     A                                  1 72DATE
     A                                  3  2'Type options, press Enter.'
     A                                      COLOR(BLU)
     A                                  4  4'5=Display'
     A                                      COLOR(BLU)
     A                                  6  2'Opt'
     A                                      DSPATR(HI)
     A                                  6  7'Cust'
     A                                      DSPATR(HI)
     A                                  6 14'Name'
     A                                      DSPATR(HI)
     A                                  6 46'City'
     A                                      DSPATR(HI)
     A          R FOOTER
     A                                      OVERLAY
     A                                 23  2'F3=Exit   F12=Cancel'
     A                                      COLOR(BLU)
     A          R DETAIL
     A                                      CA12(12 'Cancel')
     A                                  1  2SYSNAME
     A                                  1 28'Display Customer'
     A                                      DSPATR(HI)
     A                                  1 72DATE
     A                                  5  4'Customer number . . . .'
     A            CUSNO          5Y 0O  5 29EDTCDE(Z)
     A                                  6  4'Name  . . . . . . . . .'
     A            CUSNAM        30A  O  6 29
     A                                  7  4'City  . . . . . . . . .'
     A            CUSCTY        20A  O  7 29
     A                                  8  4'Balance due . . . . . .'
     A            CUSBAL         9Y 2O  8 29EDTCDE(J)
     A                                 23  2'F3=Exit   F12=Cancel'
     A                                      COLOR(BLU)
