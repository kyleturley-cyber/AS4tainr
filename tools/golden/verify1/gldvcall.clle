/* Golden: RTNVAL back in a variable; a job's environment variable in  */
/* QSYS2.ENVIRONMENT_VARIABLE_INFO; RCVMSG RMV(*YES) of a completion   */
/* message (is it still in the job log?).                              */
PGM
DCL VAR(&R) TYPE(*CHAR) LEN(10) VALUE('unchanged')
DCL VAR(&MSG) TYPE(*CHAR) LEN(150)
GLDVCMD IN(abc) OUT(&R)
CHGVAR VAR(&MSG) VALUE('R=' *CAT &R)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLDVO (VAL) VALUES(''' *CAT &MSG *TCAT +
  ''')') COMMIT(*NONE) NAMING(*SYS)
ADDENVVAR ENVVAR(GLDVENV) VALUE('job value') REPLACE(*YES)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLDVO (VAL) SELECT ''ENV '' CONCAT +
  CAST(ENVIRONMENT_VARIABLE_TYPE AS VARCHAR(10)) CONCAT '' '' CONCAT +
  CAST(ENVIRONMENT_VARIABLE_VALUE AS VARCHAR(30)) CONCAT '' '' CONCAT +
  CHAR(ENVIRONMENT_VARIABLE_CCSID) FROM QSYS2.ENVIRONMENT_VARIABLE_INFO +
  WHERE ENVIRONMENT_VARIABLE_NAME = ''GLDVENV''') COMMIT(*NONE)
CRTDTAARA DTAARA(QTEMP/GLDVRM) TYPE(*CHAR) TEXT('removed from the queue')
RCVMSG MSGTYPE(*COMP) RMV(*YES)
CRTDTAARA DTAARA(QTEMP/GLDVKP) TYPE(*CHAR) TEXT('left on the queue')
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLDVO (VAL) SELECT ''LOG '' CONCAT +
  MESSAGE_ID CONCAT '' '' CONCAT MESSAGE_TYPE CONCAT '' '' CONCAT +
  CAST(SUBSTR(MESSAGE_TEXT, 1, 60) AS VARCHAR(60)) FROM +
  TABLE(QSYS2.JOBLOG_INFO(''*'')) WHERE MESSAGE_ID = ''CPC0904''') +
  COMMIT(*NONE)
ENDPGM
