/* Golden: a validity checker: MATPGMNM's template and the call stack. */
PGM PARM(&IN &OUT)
DCLPRCOPT DFTACTGRP(*NO) ACTGRP(GLDV) BNDSRVPGM((AS4TRAINR1/GLDVSTK))
DCL VAR(&IN) TYPE(*CHAR) LEN(10)
DCL VAR(&OUT) TYPE(*CHAR) LEN(10)
DCL VAR(&DATA) TYPE(*CHAR) LEN(80)
DCL VAR(&STK) TYPE(*CHAR) LEN(60)
DCL VAR(&N) TYPE(*DEC) LEN(9 0)
DCL VAR(&T1) TYPE(*DEC) LEN(9 0)
DCL VAR(&T2) TYPE(*DEC) LEN(9 0)
DCL VAR(&MSG) TYPE(*CHAR) LEN(150)
CHGVAR VAR(%BIN(&DATA 1 4)) VALUE(80)
CHGVAR VAR(%BIN(&DATA 5 4)) VALUE(0)
CHGVAR VAR(%BIN(&DATA 9 4)) VALUE(0)
CHGVAR VAR(%BIN(&DATA 13 4)) VALUE(0)
CALLPRC PRC('_MATPGMNM') PARM((&DATA))
CHGVAR VAR(&N) VALUE(%BIN(&DATA 5 4))
CHGVAR VAR(&T1) VALUE(%BIN(&DATA 17 2))
CHGVAR VAR(&T2) VALUE(%BIN(&DATA 49 2))
CHGVAR VAR(&MSG) VALUE('MAT avail=' *CAT %CHAR(&N) *BCAT 'ctx=' *CAT +
  %CHAR(&T1) *BCAT 'pgm=' *CAT %CHAR(&T2) *BCAT %SST(&DATA 19 10) *BCAT +
  %SST(&DATA 51 10))
CALLSUBR SUBR(PUT)
CALLPRC PRC('CALLERS') PARM(&STK)
CHGVAR VAR(&MSG) VALUE('STK ' *CAT &STK)
CALLSUBR SUBR(PUT)
SUBR SUBR(PUT)
  RUNSQL SQL('INSERT INTO AS4TRAINR1/GLDVO (VAL) VALUES(''' *CAT &MSG *TCAT +
    ''')') COMMIT(*NONE) NAMING(*SYS)
ENDSUBR
ENDPGM
