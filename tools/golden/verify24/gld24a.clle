/* verify24: CHGJOB, RTVJOBA, %SWITCH and the RPG external indicators */
PGM
DCL &SWS *CHAR 8
DCL &FMT *CHAR 4
DCL &SEP *CHAR 1
DCL &TSEP *CHAR 1
DCL &RPY *CHAR 10
DCL &LVL *CHAR 1
DCL &SEV *DEC (2 0)
DCL &TXT *CHAR 10
DCL &DFMT *CHAR 1
DCL &CCSID *DEC (5 0)
DCL &OUTQ *CHAR 10
DCL &OUTQL *CHAR 10
DCL &PTY *DEC (2 0)
DCL &DATE *CHAR 6
DCL &CYMD *CHAR 7
DCL &CUR *CHAR 10
DCL &TYPE *CHAR 1
DCL &BAD *CHAR 8 VALUE('12XXXXXX')
DCL &ID *CHAR 7
DCL &N *DEC (3 0) VALUE(0)
DCL &L *CHAR 200
RTVJOBA SWS(&SWS) DATFMT(&FMT) DATSEP(&SEP) TIMSEP(&TSEP) INQMSGRPY(&RPY) +
  LOGLVL(&LVL) LOGSEV(&SEV) LOGTYPE(&TXT) DECFMT(&DFMT) CCSID(&CCSID) +
  OUTQ(&OUTQ) OUTQLIB(&OUTQL) RUNPTY(&PTY) CURLIB(&CUR) TYPE(&TYPE)
CHGVAR &L ('BEFORE|' *CAT &SWS *CAT '|' *CAT &FMT *CAT '|' *CAT &SEP *CAT '|' +
  *CAT &TSEP *CAT '|' *CAT &RPY *CAT '|' *CAT &LVL *CAT '|' *CAT %CHAR(&SEV) +
  *CAT '|' *CAT &TXT *CAT '|' *CAT &DFMT *CAT '|' *CAT %CHAR(&CCSID) *CAT '|' +
  *CAT &OUTQ *CAT '|' *CAT &OUTQL *CAT '|' *CAT %CHAR(&PTY) *CAT '|' *CAT &CUR +
  *CAT '|' *CAT &TYPE)
CALLSUBR ROW
CHGJOB SWS(10XXXXX1) DATFMT(*YMD) DATSEP('-') INQMSGRPY(*DFT) LOG(2 10 *SECLVL)
CHGJOB LOG(3 *SAME *MSG)
RTVJOBA SWS(&SWS) DATFMT(&FMT) DATSEP(&SEP) TIMSEP(&TSEP) INQMSGRPY(&RPY) +
  LOGLVL(&LVL) LOGSEV(&SEV) LOGTYPE(&TXT) DECFMT(&DFMT) DATE(&DATE) CYMDDATE(&CYMD)
CHGVAR &L ('AFTER|' *CAT &SWS *CAT '|' *CAT &FMT *CAT '|' *CAT &SEP *CAT '|' +
  *CAT &TSEP *CAT '|' *CAT &RPY *CAT '|' *CAT &LVL *CAT '|' *CAT %CHAR(&SEV) +
  *CAT '|' *CAT &TXT *CAT '|' *CAT &DFMT *CAT '|' *CAT &DATE *CAT '|' *CAT &CYMD)
CALLSUBR ROW
IF COND(%SWITCH(1XXXXXX1)) THEN(CHGVAR &L 'SWITCH 1XXXXXX1 ON')
ELSE CMD(CHGVAR &L 'SWITCH 1XXXXXX1 OFF')
CALLSUBR ROW
IF COND(%SWITCH(0XXXXXXX)) THEN(CHGVAR &L 'SWITCH 0XXXXXXX ON')
ELSE CMD(CHGVAR &L 'SWITCH 0XXXXXXX OFF')
CALLSUBR ROW
CALL GLD24R
RTVJOBA SWS(&SWS)
CHGVAR &L ('AFTER RPG|' *CAT &SWS)
CALLSUBR ROW
CHGVAR &ID ' '
CHGJOB SWS(&BAD)
MONMSG CPF0000 EXEC(RCVMSG MSGTYPE(*EXCP) RMV(*NO) MSGID(&ID))
CHGVAR &L ('BAD SWS|' *CAT &ID)
CALLSUBR ROW
RETURN
SUBR ROW
CHGVAR &N (&N + 1)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLD24OUT VALUES(' *CAT %CHAR(&N) *CAT ', ''' +
  *CAT %TRIMR(&L) *CAT ''')') COMMIT(*NONE)
ENDSUBR
ENDPGM
