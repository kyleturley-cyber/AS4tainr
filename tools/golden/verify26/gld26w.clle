/* verify26: callers of failing ILE and OPM CL programs with the     */
/* inquiry reply *DFT; %CHAR of *INT 2 and 8, *UINT 4, *DEC 0 values  */
PGM PARM(&WHICH)
DCL &WHICH *CHAR 1
DCL &L *CHAR 200
DCL &ID *CHAR 7
DCL &N *DEC (3 0) VALUE(0)
DCL &I2 *INT 2 VALUE(-5)
DCL &I8 *INT 8 VALUE(9)
DCL &U4 *UINT 4 VALUE(8)
DCL &D0 *DEC (7 2) VALUE(0)
CHGJOB INQMSGRPY(*DFT)
IF (&WHICH *EQ 'I') THEN(DO)
  CALL GLD26D
  RETURN
ENDDO
IF (&WHICH *EQ 'O') THEN(DO)
  CALL GLD26E
  RETURN
ENDDO
CHGVAR &L ('[' *CAT %CHAR(&I2) *CAT '][' *CAT %CHAR(&I8) *CAT '][' *CAT +
  %CHAR(&U4) *CAT '][' *CAT %CHAR(&D0) *CAT ']')
CALLSUBR ROW
CHGVAR &ID ' '
CALL GLD26D
MONMSG MSGID(CPF0001 CEE9901 CPF9999) EXEC(RCVMSG MSGTYPE(*EXCP) RMV(*NO) MSGID(&ID))
CHGVAR &L ('ILE CALLEE|' *CAT &ID)
CALLSUBR ROW
CHGVAR &ID ' '
CALL GLD26E
MONMSG MSGID(CPF0001 CEE9901 CPF9999) EXEC(RCVMSG MSGTYPE(*EXCP) RMV(*NO) MSGID(&ID))
CHGVAR &L ('OPM CALLEE|' *CAT &ID)
CALLSUBR ROW
RETURN
SUBR ROW
CHGVAR &N (&N + 1)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLD26OUT VALUES(' *CAT %CHAR(&N) *CAT ', ''' +
  *CAT %TRIMR(&L) *CAT ''')') COMMIT(*NONE)
ENDSUBR
ENDPGM
