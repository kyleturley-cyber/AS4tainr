/* verify28: run GLD28F and GLD28U and record what they return */
PGM
DCL &L *CHAR 200
DCL &R *CHAR 10
CHGJOB INQMSGRPY(*DFT)
CALL GLD28F PARM(&L)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLD28OUT VALUES(1, ''' *CAT %TRIMR(&L) +
  *CAT ''')') COMMIT(*NONE)
CALL GLD28U PARM(&R)
RUNSQL SQL('INSERT INTO AS4TRAINR1/GLD28OUT VALUES(2, ''' *CAT %TRIMR(&R) +
  *CAT ''')') COMMIT(*NONE)
ENDPGM
