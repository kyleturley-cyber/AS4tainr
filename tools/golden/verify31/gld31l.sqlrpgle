**FREE
// verify31: QSRLSAVF on AS4TRAINR1/GLD31S, formats SAVF0200 and
// SAVF0100: the generic header, the header section and each entry, in
// hexadecimal, into AS4TRAINR1/GLD31OUT.
ctl-opt dftactgrp(*no) actgrp(*new);
dcl-pr QUSCRTUS extpgm('QUSCRTUS');
  name char(20) const;
  attr char(10) const;
  size int(10) const;
  init char(1) const;
  aut char(10) const;
  text char(50) const;
  repl char(10) const;
  err likeds(errds);
end-pr;
dcl-pr QUSPTRUS extpgm('QUSPTRUS');
  name char(20) const;
  ptr pointer;
end-pr;
dcl-pr QSRLSAVF extpgm('QSRLSAVF');
  space char(20) const;
  format char(8) const;
  savf char(20) const;
  obj char(10) const;
  type char(10) const;
  handle char(36) const;
  err likeds(errds);
end-pr;
dcl-ds errds qualified;
  prov int(10) inz(116);
  avail int(10);
  id char(7);
  res char(1);
  data char(100);
end-ds;
dcl-s p pointer;
dcl-s q pointer;
dcl-s int4 int(10) based(q);
dcl-s bytes char(300) based(q);
dcl-s n int(10) inz(0);
dcl-s line varchar(700);
dcl-s h varchar(600);
dcl-ds conv;
  v uns(5) pos(1);
  c char(1) pos(2);
end-ds;
dcl-s fmt char(8);
dcl-s k int(10);
dcl-s listoff int(10);
dcl-s count int(10);
dcl-s entsize int(10);
dcl-s hdroff int(10);
dcl-s hdrsize int(10);
dcl-s i int(10);

for k = 1 to 2;
  if k = 1;
    fmt = 'SAVF0200';
  else;
    fmt = 'SAVF0100';
  endif;
  QUSCRTUS('GLD31U    QTEMP' : 'LIST' : 4096 : x'00' : '*ALL' : 'verify31' : '*YES' : errds);
  QSRLSAVF('GLD31U    QTEMP' : fmt : 'GLD31S    AS4TRAINR1' : '*ALL' : '*ALL' : ' ' : errds);
  if errds.avail > 0;
    addline(fmt + ' error ' + errds.id);
    iter;
  endif;
  QUSPTRUS('GLD31U    QTEMP' : p);
  q = p + 124;
  listoff = int4;
  q = p + 132;
  count = int4;
  q = p + 136;
  entsize = int4;
  q = p + 116;
  hdroff = int4;
  q = p + 120;
  hdrsize = int4;
  addline(fmt + ' count ' + %char(count) + ' size ' + %char(entsize) + ' header ' + %char(hdrsize));
  q = p + 64;
  addline(fmt + ' generic ' + hexof(128));
  q = p + hdroff;
  addline(fmt + ' headersection ' + hexof(hdrsize));
  for i = 0 to count - 1;
    q = p + listoff + i * entsize;
    addline(fmt + ' entry ' + %char(i + 1) + ' ' + %subst(bytes : 1 : 30));
    addline(fmt + ' hex ' + %char(i + 1) + ' ' + hexof(entsize));
  endfor;
endfor;
*inlr = *on;

dcl-proc hexof;
  dcl-pi *n varchar(600);
    len int(10) const;
  end-pi;
  dcl-s l int(10);
  dcl-s j int(10);
  l = len;
  if l > 300;
    l = 300;
  endif;
  h = '';
  for j = 1 to l;
    v = 0;
    c = %subst(bytes : j : 1);
    h += %subst('0123456789ABCDEF' : %div(v : 16) + 1 : 1)
       + %subst('0123456789ABCDEF' : %rem(v : 16) + 1 : 1);
  endfor;
  return h;
end-proc;

dcl-proc addline;
  dcl-pi *n;
    text varchar(700) const;
  end-pi;
  n += 1;
  line = text;
  exec sql INSERT INTO AS4TRAINR1.GLD31OUT VALUES (:n, :line);
end-proc;
