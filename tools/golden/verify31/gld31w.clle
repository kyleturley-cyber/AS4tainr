/* verify31: GLD31N twice in one job; QTEMP in OBJECT_STATISTICS.     */
PGM
CALL       PGM(AS4TRAINR1/GLD31N)
CALL       PGM(AS4TRAINR1/GLD31N)
CRTSAVF    FILE(QTEMP/GLD31X)
RUNSQL     SQL('INSERT INTO AS4TRAINR1.GLD31OUT SELECT 910, +
             OBJLIB CONCAT '' '' CONCAT OBJNAME FROM +
             TABLE(QSYS2.OBJECT_STATISTICS(''QTEMP'', ''*FILE'')) X +
             WHERE OBJNAME = ''GLD31X''') COMMIT(*NONE)
ENDPGM
