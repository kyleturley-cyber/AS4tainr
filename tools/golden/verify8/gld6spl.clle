/* Golden: CPYSPLF in a batch job (tools/golden/verify8.txt).   */
/* Each CPYSPLF's message goes into GLD6LOG as A, B or C.       */
PGM
  DCL        VAR(&ID) TYPE(*CHAR) LEN(7)
  DCL        VAR(&MSG) TYPE(*CHAR) LEN(200)
  DCL        VAR(&STMT) TYPE(*CHAR) LEN(300)
  DCL        VAR(&TAG) TYPE(*CHAR) LEN(1)
  DSPFFD     FILE(AS4TRAINR1/GLD6TB) OUTPUT(*PRINT)
  RMVMSG     CLEAR(*ALL)
  CHGVAR     VAR(&TAG) VALUE('A')
  CPYSPLF    FILE(QPDSPFFD) TOFILE(AS4TRAINR1/GLD6SP) SPLNBR(*LAST)
  MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EXCP))
  CALLSUBR   SUBR(LOG)
  RMVMSG     CLEAR(*ALL)
  CHGVAR     VAR(&TAG) VALUE('B')
  CPYSPLF    FILE(QPDSPFFD) TOFILE(AS4TRAINR1/GLD6SP) SPLNBR(*LAST) +
               MBROPT(*ADD) CTLCHAR(*FCFC)
  MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EXCP))
  CALLSUBR   SUBR(LOG)
  RMVMSG     CLEAR(*ALL)
  CHGVAR     VAR(&TAG) VALUE('C')
  CPYSPLF    FILE(QPDSPFFD) TOFILE(AS4TRAINR1/GLD6TB) SPLNBR(*LAST)
  MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EXCP))
  CALLSUBR   SUBR(LOG)
  GOTO       CMDLBL(PRINT)
EXCP:
  RCVMSG     MSGTYPE(*EXCP) MSG(&MSG) MSGID(&ID)
  CHGVAR     VAR(&STMT) VALUE('INSERT INTO AS4TRAINR1/GLD6LOG +
               VALUES(''' *CAT &TAG *CAT ' EXCP ' *CAT &ID *CAT ''')')
  RUNSQL     SQL(&STMT) COMMIT(*NONE)
/* Display commands' printed reports: which printer file each uses */
/* (the spooled files are listed by verify7.txt c7_spl).            */
PRINT:
  DSPOBJD    OBJ(AS4TRAINR1/GLD6TB) OBJTYPE(*FILE) OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  DSPFD      FILE(AS4TRAINR1/GLD6TB) OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  DSPLIBL    OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  DSPSYSVAL  SYSVAL(QDATE) OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  DSPMSGD    RANGE(CPF9898) MSGF(QCPFMSG) OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  DSPJOB     OUTPUT(*PRINT) OPTION(*DFNA)
  MONMSG     MSGID(CPF0000)
  DSPLIB     LIB(QTEMP) OUTPUT(*PRINT)
  MONMSG     MSGID(CPF0000)
  CPYF       FROMFILE(AS4TRAINR1/GLD6TB) TOFILE(*PRINT)
  MONMSG     MSGID(CPF0000)
  RETURN
  SUBR       SUBR(LOG)
    RCVMSG     MSGTYPE(*LAST) MSG(&MSG) MSGID(&ID)
    CHGVAR     VAR(&STMT) VALUE('INSERT INTO AS4TRAINR1/GLD6LOG +
                 VALUES(''' *CAT &TAG *CAT ' ' *CAT &ID *CAT ' ' +
                 *CAT %TRIM(&MSG) *CAT ''')')
    RUNSQL     SQL(&STMT) COMMIT(*NONE)
  ENDSUBR
ENDPGM
